---
// BaseLayout.astro — Layout utama + SEO meta tags
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Candra Bagus — Portfolio",
  description = "Full-Stack Developer & Creative Coder. Membangun antarmuka yang hidup dan sistem yang solid.",
  image = "/og-image.png",
} = Astro.props;

const siteUrl = "https://candrabagus.dev";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
---

<!doctype html>
<html lang="id" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- SEO Primary -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="author" content="Candra Bagus" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, siteUrl)} />
    <meta property="og:locale" content="id_ID" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, siteUrl)} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Pixel&family=Pixelify+Sans:wght@400..700&family=JetBrains+Mono:wght@400;500&family=Press+Start+2P&family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&family=Syne:wght@700;800&family=Newsreader:ital,opsz,wght@1,6..72,400..700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#0d0d1a] text-white overflow-hidden">
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --c-accent:   #7C3AED;
    --c-accent2:  #06b6d4;
    --c-bg:       #0d0d1a;
    --c-surface:  #1a1a2e;
    --c-border:   rgba(255,255,255,0.08);
    --c-text:     #e2e8f0;
    --c-muted:    #64748b;
    --font-pixel: 'Press Start 2P', monospace;
    --font-sans:  'Geist Pixel', system-ui, sans-serif;
    --font-mono:  'JetBrains Mono', monospace;
    --font-header: 'Pixelify Sans', system-ui, sans-serif;
    --font-body:   'Geist Pixel', system-ui, sans-serif;
  }

  * { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    font-family: var(--font-body);
    background: var(--c-bg);
    color: var(--c-text);
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-header);
  }

  /* Scrollbar custom */
  ::-webkit-scrollbar       { width: 6px; }
  ::-webkit-scrollbar-track { background: var(--c-surface); }
  ::-webkit-scrollbar-thumb { background: var(--c-accent); border-radius: 3px; }

  /* Selection */
  ::selection { background: var(--c-accent); color: white; }
</style>
