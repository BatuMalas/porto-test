---
// TechPlanetaryOrbit.astro — 3D Planetary Inline Orbit Carousel
// Formasi 3 planet berjejer lurus secara horizontal di sumbu X dengan fokus utama di tengah.
// Orbit elips horizontal memanjang dengan perpindahan smooth snap, z-index depth, dan satelit anti-tabrakan.
---

<div class="tech-planetary-carousel w-full relative select-none">
  <!-- Interactive Navigation Controls & Drag Hint -->
  <div
    class="w-full flex items-center justify-between sm:justify-center gap-4 mb-4 px-2"
  >
    <!-- Left spin button (Putar Kiri: geser formasi ke kiri) -->
    <button
      id="planet-spin-prev"
      type="button"
      class="p-2 sm:px-4 sm:py-2 rounded-full bg-neutral-100 hover:bg-neutral-200 text-neutral-800 text-xs font-mono font-bold transition-all hover:scale-105 active:scale-95 shadow-2xs border border-neutral-200/90 cursor-pointer flex items-center gap-2 group"
      title="Putar formasi ke kiri"
    >
      <svg
        class="w-4 h-4 transition-transform group-hover:-translate-x-0.5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
      >
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
      <!-- <span class="hidden sm:inline font-sans font-semibold">Putar Kiri</span> -->
    </button>

    <!-- Center Drag Hint Badge with orbital arrow icon -->
    <div
      class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/95 border border-neutral-200/90 text-xs font-mono text-neutral-600 shadow-xs"
    >
      <svg
        class="w-4 h-4 text-blue-600 animate-spin"
        style="animation-duration: 8s;"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M21 12a9 9 0 11-6.219-8.56"></path>
      </svg>
      <!-- <span class="font-sans font-medium text-neutral-700">Geser horizontal untuk memutar formasi</span> -->
    </div>

    <!-- Right spin button (Putar Kanan: geser formasi ke kanan) -->
    <button
      id="planet-spin-next"
      type="button"
      class="p-2 sm:px-4 sm:py-2 rounded-full bg-neutral-100 hover:bg-neutral-200 text-neutral-800 text-xs font-mono font-bold transition-all hover:scale-105 active:scale-95 shadow-2xs border border-neutral-200/90 cursor-pointer flex items-center gap-2 group"
      title="Putar formasi ke kanan"
    >
      <!-- <span class="hidden sm:inline font-sans font-semibold">Putar Kanan</span> -->
      <svg
        class="w-4 h-4 transition-transform group-hover:translate-x-0.5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
      >
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  </div>

  <!-- Main 3D Carousel Stage (Horizontal Inline Layout) -->
  <div
    id="carousel-stage"
    class="relative w-full h-[440px] sm:h-[470px] flex items-center justify-center overflow-visible cursor-grab active:cursor-grabbing touch-none select-none"
  >
    <!-- ═══ PLANET 0: FRONT END ═════════════════════════════════════ -->
    <div
      class="planet-system-node absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 pointer-events-auto cursor-pointer"
      data-index="0"
      data-id="frontend"
    >
      <div
        class="planet-system-inner relative w-[260px] h-[260px] flex items-center justify-center"
      >
        <!-- Local Orbit rings around this planet -->
        <svg
          class="absolute inset-0 w-full h-full pointer-events-none overflow-visible"
          viewBox="-130 -130 260 260"
        >
          <ellipse
            cx="0"
            cy="0"
            rx="100"
            ry="40"
            fill="none"
            stroke="#2563EB"
            stroke-opacity="0.35"
            stroke-width="1.8"
            transform="rotate(-18)"></ellipse>
          <ellipse
            cx="0"
            cy="0"
            rx="108"
            ry="44"
            fill="none"
            stroke="#94A3B8"
            stroke-opacity="0.45"
            stroke-width="1.4"
            stroke-dasharray="4 4"
            transform="rotate(22)"></ellipse>
        </svg>

        <!-- Central Planet Globe -->
        <div
          class="planet-globe relative z-10 w-32 h-32 sm:w-36 sm:h-36 rounded-full flex flex-col items-center justify-center text-center bg-white border-[4px] border-blue-600 shadow-xl select-none"
        >
          <div
            class="absolute inset-1.5 rounded-full border-2 border-dashed border-blue-300/70 pointer-events-none"
          >
          </div>
          <span
            class="text-xl sm:text-2xl font-black tracking-wider text-blue-600 leading-none"
            >FRONT</span
          >
          <span
            class="text-xl sm:text-2xl font-black tracking-wider text-blue-600 leading-none mt-1"
            >END</span
          >
        </div>

        <!-- Satellites (Tech stack icons) -->
        <div class="satellites-group absolute inset-0 pointer-events-none">
          <!-- React -->
          <div
            class="orbit-sat pointer-events-auto"
            data-angle="0"
            data-tilt="-18"
            data-rx="100"
            data-ry="40"
            title="React.js"
          >
            <div class="sat-badge bg-white border border-neutral-300 shadow-md">
              <svg
                class="w-5 h-5 text-[#087EA4]"
                viewBox="-11.5 -10.23174 23 20.46348"
                fill="none"
              >
                <circle cx="0" cy="0" r="2.05" fill="#087EA4"></circle>
                <g stroke="#087EA4" stroke-width="1">
                  <ellipse rx="11" ry="4.2"></ellipse>
                  <ellipse rx="11" ry="4.2" transform="rotate(60)"></ellipse>
                  <ellipse rx="11" ry="4.2" transform="rotate(120)"></ellipse>
                </g>
              </svg>
            </div>
          </div>

          <!-- TypeScript -->
          <div
            class="orbit-sat pointer-events-auto"
            data-angle="52"
            data-tilt="-18"
            data-rx="100"
            data-ry="40"
            title="TypeScript"
          >
            <div
              class="sat-badge bg-[#3178C6] border border-[#235A97] shadow-md text-white font-bold text-xs font-mono"
            >
              TS
            </div>
          </div>

          <!-- JavaScript -->
          <div
            class="orbit-sat pointer-events-auto"
            data-angle="104"
            data-tilt="-18"
            data-rx="100"
            data-ry="40"
            title="JavaScript"
          >
            <div
              class="sat-badge bg-[#F7DF1E] border border-[#D5BE15] shadow-md text-black font-extrabold text-xs font-mono"
            >
              JS
            </div>
          </div>

          <!-- Vue.js -->
          <div
            class="orbit-sat pointer-events-auto"
            data-angle="155"
            data-tilt="22"
            data-rx="108"
            data-ry="44"
            title="Vue.js"
          >
            <div class="sat-badge bg-white border border-neutral-300 shadow-md">
              <svg class="w-4 h-4" viewBox="0 0 256 221" fill="none">
                <path
                  d="M204.8 0H256L128 220.8 0 0h97.92L128 51.2 157.44 0h47.36z"
                  fill="#42B883"></path>
                <path
                  d="M0 0l128 220.8L256 0h-51.2L128 132.48 49.92 0H0z"
                  fill="#35495E"></path>
              </svg>
            </div>
          </div>

          <!-- HTML5 -->
          <div
            class="orbit-sat pointer-events-auto"
            data-angle="210"
            data-tilt="22"
            data-rx="108"
            data-ry="44"
            title="HTML5"
          >
            <div
              class="sat-badge bg-[#E34F26] border border-[#C23C16] shadow-md text-white font-black text-[10px]"
            >
              HTML
            </div>
          </div>

          <!-- CSS3 -->
          <div
            class="orbit-sat pointer-events-auto"
            data-angle="265"
            data-tilt="-18"
            data-rx="100"
            data-ry="40"
            title="CSS3"
          >
            <div
              class="sat-badge bg-[#1572B6] border border-[#10568B] shadow-md text-white font-black text-[10px]"
            >
              CSS
            </div>
          </div>

          <!-- Tailwind CSS -->
          <div
            class="orbit-sat pointer-events-auto"
            data-angle="315"
            data-tilt="22"
            data-rx="108"
            data-ry="44"
            title="Tailwind CSS"
          >
            <div class="sat-badge bg-white border border-neutral-300 shadow-md">
              <svg
                class="w-4 h-4 text-[#38BDF8]"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M12.001 4.8c-3.2 0-5.2 1.6-6 4.8 1.2-1.6 2.6-2.2 4.2-1.8.913.228 1.565.89 2.288 1.624C13.666 10.618 15.027 12 18.001 12c3.2 0 5.2-1.6 6-4.8-1.2 1.6-2.6 2.2-4.2 1.8-.913-.228-1.565-.89-2.288-1.624C16.337 6.182 14.976 4.8 12.001 4.8zm-6 7.2c-3.2 0-5.2 1.6-6 4.8 1.2-1.6 2.6-2.2 4.2-1.8.913.228 1.565.89 2.288 1.624 1.177 1.194 2.538 2.576 5.512 2.576 3.2 0 5.2-1.6 6-4.8-1.2 1.6-2.6 2.2-4.2 1.8-.913-.228-1.565-.89-2.288-1.624C10.337 13.382 8.976 12 6.001 12z"
                ></path>
              </svg>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ═══ PLANET 1: BACK END ══════════════════════════════════════ -->
    <div
      class="planet-system-node absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 pointer-events-auto cursor-pointer"
      data-index="1"
      data-id="backend"
    >
      <div
        class="planet-system-inner relative w-[260px] h-[260px] flex items-center justify-center"
      >
        <!-- Local Orbit rings -->
        <svg
          class="absolute inset-0 w-full h-full pointer-events-none overflow-visible"
          viewBox="-130 -130 260 260"
        >
          <ellipse
            cx="0"
            cy="0"
            rx="100"
            ry="40"
            fill="none"
            stroke="#EA580C"
            stroke-opacity="0.38"
            stroke-width="1.8"
            transform="rotate(-15)"></ellipse>
          <ellipse
            cx="0"
            cy="0"
            rx="108"
            ry="44"
            fill="none"
            stroke="#94A3B8"
            stroke-opacity="0.45"
            stroke-width="1.4"
            stroke-dasharray="4 4"
            transform="rotate(25)"></ellipse>
        </svg>

        <!-- Central Planet Globe -->
        <div
          class="planet-globe relative z-10 w-32 h-32 sm:w-36 sm:h-36 rounded-full flex flex-col items-center justify-center text-center bg-[#E55A36] border-[4px] border-[#C44322] shadow-xl select-none"
        >
          <div
            class="absolute inset-1.5 rounded-full border-2 border-dashed border-white/30 pointer-events-none"
          >
          </div>
          <span
            class="text-xl sm:text-2xl font-black tracking-wider text-neutral-950 leading-none"
            >BACK</span
          >
          <span
            class="text-xl sm:text-2xl font-black tracking-wider text-neutral-950 leading-none mt-1"
            >END</span
          >
        </div>

        <!-- Satellites -->
        <div class="satellites-group absolute inset-0 pointer-events-none">
          <!-- Node.js -->
          <div
            class="orbit-sat pointer-events-auto"
            data-angle="10"
            data-tilt="-15"
            data-rx="100"
            data-ry="40"
            title="Node.js"
          >
            <div
              class="sat-badge bg-[#EBF8EE] border border-[#417E38] shadow-md text-[#339933] font-bold text-[10px]"
            >
              node
            </div>
          </div>

          <!-- Python -->
          <div
            class="orbit-sat pointer-events-auto"
            data-angle="68"
            data-tilt="-15"
            data-rx="100"
            data-ry="40"
            title="Python"
          >
            <div class="sat-badge bg-white border border-neutral-300 shadow-md">
              <svg class="w-4 h-4" viewBox="0 0 110 110" fill="none">
                <path
                  d="M54.1 2C27.6 2 29.2 13.5 29.2 13.5l.03 12.02h25.4v3.61H19.98S2 27.2 2 54.1c0 26.9 15.6 25.9 15.6 25.9h9.33v-13.1s-.5-15.6 15.35-15.6h24.87s14.8.2 14.8-14.3V16.3S84 2 54.1 2zm-13.7 7.7a3.8 3.8 0 11.02 7.6 3.8 3.8 0 01-.02-7.6z"
                  fill="#366A96"></path>
                <path
                  d="M55.9 108c26.5 0 24.9-11.5 24.9-11.5l-.03-12.02H55.37v-3.61h34.65s18 1.9 18-25c0-26.9-15.6-25.9-15.6-25.9h-9.33v13.1s.5 15.6-15.35 15.6H43.87s-14.8-.2-14.8 14.3v15.7S26 108 55.9 108zm13.7-7.7a3.8 3.8 0 11-.02-7.6 3.8 3.8 0 01.02 7.6z"
                  fill="#FFC331"></path>
              </svg>
            </div>
          </div>

          <!-- PostgreSQL -->
          <div
            class="orbit-sat pointer-events-auto"
            data-angle="125"
            data-tilt="25"
            data-rx="108"
            data-ry="44"
            title="PostgreSQL"
          >
            <div
              class="sat-badge bg-[#EBF3FB] border border-[#336791] shadow-md"
            >
              <svg
                class="w-4 h-4 text-[#336791]"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 14.5c0 .83-.67 1.5-1.5 1.5S10 17.33 10 16.5v-3c0-.83.67-1.5 1.5-1.5s1.5.67 1.5 1.5v3zm3-4c0 .83-.67 1.5-1.5 1.5S13 13.33 13 12.5v-2c0-.83.67-1.5 1.5-1.5s1.5.67 1.5 1.5v2zm-6 1c0 .83-.67 1.5-1.5 1.5S7 14.33 7 13.5v-1c0-.83.67-1.5 1.5-1.5s1.5.67 1.5 1.5v1z"
                ></path>
              </svg>
            </div>
          </div>

          <!-- Golang -->
          <div
            class="orbit-sat pointer-events-auto"
            data-angle="185"
            data-tilt="-15"
            data-rx="100"
            data-ry="40"
            title="Golang"
          >
            <div
              class="sat-badge bg-[#00ADD8] border border-[#0089AB] shadow-md text-white font-extrabold text-[11px] font-mono tracking-tighter"
            >
              =GO
            </div>
          </div>

          <!-- Express -->
          <div
            class="orbit-sat pointer-events-auto"
            data-angle="245"
            data-tilt="25"
            data-rx="108"
            data-ry="44"
            title="Express.js"
          >
            <div
              class="sat-badge bg-white border border-neutral-300 shadow-md text-neutral-800 font-bold text-[9px]"
            >
              Express
            </div>
          </div>

          <!-- FastAPI -->
          <div
            class="orbit-sat pointer-events-auto"
            data-angle="305"
            data-tilt="-15"
            data-rx="100"
            data-ry="40"
            title="FastAPI"
          >
            <div
              class="sat-badge bg-[#E6F4EA] border border-[#059669] shadow-md"
            >
              <svg
                class="w-4 h-4 text-[#059669]"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path d="M12 2L3 13h7l-1 9 9-11h-7l1-9z"></path>
              </svg>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ═══ PLANET 2: DEV OPS ═══════════════════════════════════════ -->
    <div
      class="planet-system-node absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 pointer-events-auto cursor-pointer"
      data-index="2"
      data-id="devops"
    >
      <div
        class="planet-system-inner relative w-[260px] h-[260px] flex items-center justify-center"
      >
        <!-- Local Orbit rings -->
        <svg
          class="absolute inset-0 w-full h-full pointer-events-none overflow-visible"
          viewBox="-130 -130 260 260"
        >
          <ellipse
            cx="0"
            cy="0"
            rx="100"
            ry="40"
            fill="none"
            stroke="#0284C7"
            stroke-opacity="0.38"
            stroke-width="1.8"
            transform="rotate(-20)"></ellipse>
          <ellipse
            cx="0"
            cy="0"
            rx="108"
            ry="44"
            fill="none"
            stroke="#94A3B8"
            stroke-opacity="0.45"
            stroke-width="1.4"
            stroke-dasharray="4 4"
            transform="rotate(20)"></ellipse>
        </svg>

        <!-- Central Planet Globe -->
        <div
          class="planet-globe relative z-10 w-32 h-32 sm:w-36 sm:h-36 rounded-full flex flex-col items-center justify-center text-center shadow-xl select-none"
          style="background: linear-gradient(135deg, #7DD3FC, #86EFAC); border: 4px solid #0284C7;"
        >
          <div
            class="absolute inset-1.5 rounded-full border-2 border-dashed border-white/50 pointer-events-none"
          >
          </div>
          <span
            class="text-xl sm:text-2xl font-black tracking-wider text-slate-900 leading-none"
            >DEV</span
          >
          <span
            class="text-xl sm:text-2xl font-black tracking-wider text-slate-900 leading-none mt-1"
            >OPS</span
          >
        </div>

        <!-- Satellites -->
        <div class="satellites-group absolute inset-0 pointer-events-none">
          <!-- Docker -->
