            class="orbit-sat pointer-events-auto"
            data-angle="15"
            data-tilt="-20"
            data-rx="100"
            data-ry="40"
            title="Docker"
          >
            <div
              class="sat-badge bg-[#EBF5FB] border border-[#2496ED] shadow-md"
            >
              <svg
                class="w-4 h-4 text-[#2496ED]"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M13.983 11.078h2.119a.186.186 0 00.186-.185V9.006a.186.186 0 00-.186-.186h-2.119a.185.185 0 00-.185.185v1.888c0 .102.083.185.185.185m-2.954-5.43h2.118a.186.186 0 00.186-.186V3.574a.186.186 0 00-.186-.185h-2.118a.185.185 0 00-.185.185v1.888c0 .102.082.185.185.185m0 2.716h2.118a.187.187 0 00.186-.186V6.29a.186.186 0 00-.186-.185h-2.118a.185.185 0 00-.185.185v1.887c0 .102.082.186.185.186m-2.93 0h2.12a.186.186 0 00.184-.186V6.29a.185.185 0 00-.185-.185H8.1a.185.185 0 00-.185.185v1.887c0 .102.083.186.185.186m-2.964 0h2.119a.186.186 0 00.185-.186V6.29a.185.185 0 00-.185-.185H5.136a.186.186 0 00-.186.185v1.887c0 .102.084.186.186.186m5.893 2.715h2.118a.186.186 0 00.186-.185V9.006a.186.186 0 00-.186-.186h-2.118a.185.185 0 00-.185.185v1.888c0 .102.082.185.185.185m-2.93 0h2.12a.185.185 0 00.184-.185V9.006a.185.185 0 00-.184-.186h-2.12a.185.185 0 00-.184.185v1.888c0 .102.083.185.185.185m-2.964 0h2.119a.185.185 0 00.185-.185V9.006a.185.185 0 00-.185-.186H5.136a.186.186 0 00-.186.185v1.888c0 .102.084.185.186.185m-2.92 0h2.12a.185.185 0 00.184-.185V9.006a.185.185 0 00-.184-.186h-2.12a.185.185 0 00-.184.185v1.888c0 .102.082.185.185.185M23.76 9.89a7.64 7.64 0 00-3.66-3.158l-.348-.142-.238.293c-.477.587-1.077 1.056-1.748 1.368-.26.12-.533.21-.81.27v2.55h4.86c.64.004 1.258.26 1.716.71.077.068.175.093.228.007zM.004 11.53c-.027.674.053 1.348.24 1.996 1.045 3.498 4.246 5.86 7.9 5.86 5.973 0 10.985-3.834 12.355-9.356H.49a4.8 4.8 0 00-.486 1.5"
                ></path>
