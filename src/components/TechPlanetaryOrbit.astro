              class="sat-badge bg-white border border-neutral-300 shadow-md text-[#FF9900] font-black text-[10px] font-mono"
            >
              aws
            </div>
          </div>

          <!-- Linux -->
          <div
            class="orbit-sat pointer-events-auto"
            data-angle="250"
            data-tilt="-20"
            data-rx="100"
            data-ry="40"
            title="Linux"
          >
            <div
              class="sat-badge bg-[#FFFBEB] border border-[#F59E0B] shadow-md text-neutral-900 font-bold text-xs"
            >
              🐧
            </div>
          </div>

          <!-- Figma -->
          <div
            class="orbit-sat pointer-events-auto"
            data-angle="305"
            data-tilt="20"
            data-rx="108"
            data-ry="44"
            title="Figma Design"
          >
            <div class="sat-badge bg-white border border-neutral-300 shadow-md">
              <svg class="w-3.5 h-4" viewBox="0 0 38 57" fill="none">
                <path
                  d="M19 28.5a9.5 9.5 0 1119 0 9.5 9.5 0 01-19 0z"
                  fill="#1ABCFE"></path>
                <path
                  d="M0 47.5A9.5 9.5 0 019.5 38H19v9.5a9.5 9.5 0 11-19 0z"
                  fill="#0ACF83"></path>
                <path d="M19 0v19h9.5a9.5 9.5 0 100-19H19z" fill="#FF7262"
                ></path>
                <path
                  d="M0 9.5A9.5 9.5 0 009.5 19H19V0H9.5A9.5 9.5 0 000 9.5z"
                  fill="#F24E1E"></path>
                <path
                  d="M0 28.5A9.5 9.5 0 009.5 38H19V19H9.5A9.5 9.5 0 000 28.5z"
                  fill="#A259FF"></path>
              </svg>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // ══════════════════════════════════════════════════════════════
  // HORIZONTAL INLINE PLANETARY CAROUSEL WITH 3D DEPTH
  // ══════════════════════════════════════════════════════════════

  interface SatelliteNode {
    el: HTMLElement;
    baseAngle: number;
    tiltRad: number;
    rx: number;
    ry: number;
  }

  interface PlanetNode {
    el: HTMLElement;
    globe: HTMLElement;
    index: number;
    satellites: SatelliteNode[];
    internalSpin: number;
  }

  const stage = document.getElementById("carousel-stage") as HTMLElement;
  const planetElements = Array.from(
    document.querySelectorAll<HTMLElement>(".planet-system-node"),
  );
  const prevBtn = document.getElementById("planet-spin-prev");
  const nextBtn = document.getElementById("planet-spin-next");

  const planets: PlanetNode[] = planetElements.map((el, i) => {
    const globe = el.querySelector<HTMLElement>(".planet-globe")!;
    const satEls = Array.from(el.querySelectorAll<HTMLElement>(".orbit-sat"));

    const satellites: SatelliteNode[] = satEls.map((sat) => {
      const angleDeg = parseFloat(sat.dataset.angle || "0");
      const tiltDeg = parseFloat(sat.dataset.tilt || "0");
      const rx = parseFloat(sat.dataset.rx || "100");
      const ry = parseFloat(sat.dataset.ry || "40");

      return {
        el: sat,
        baseAngle: (angleDeg * Math.PI) / 180,
        tiltRad: (tiltDeg * Math.PI) / 180,
        rx,
        ry,
      };
    });

    return {
      el,
      globe,
      index: i,
      satellites,
      internalSpin: 0,
    };
  });

  // ── SUDUT KOORDINAT HORIZONTAL INLINE ──
  // Step rotasi = 120 derajat (2*PI / 3)
  const STEP_RAD = (2 * Math.PI) / 3;

  // Posisi Default:
  // carouselAngle = 0 menempatkan Planet 0 (Front End) di tengah depan (X = 0, Z = +1).
  // Planet 1 (Back End) di kanan (X = +0.866 * radiusX, Z = -0.5).
  // Planet 2 (Dev Ops) di kiri (X = -0.866 * radiusX, Z = -0.5).
  // Tiga planet berjejer lurus secara horizontal di sumbu X!
  let currentCarouselAngle = 0;
  let targetCarouselAngle = 0;

  let isDragging = false;
  let startPointerX = 0;
  let lastPointerX = 0;
  let dragVelocity = 0;
  let lastMoveTime = performance.now();

  function getCarouselDimensions() {
    const isMobile = window.innerWidth < 640;
    const isTablet = window.innerWidth < 1024;
    return {
      // Horizontal separation on X-axis
      radiusX: isMobile ? 185 : isTablet ? 270 : 340,
      // Very slight vertical perspective depth (keeps inline horizontal feel)
      radiusY: isMobile ? 6 : 10,
    };
  }

  // ── POINTER DRAG / SWIPE HORIZONTAL ──
  stage.addEventListener("pointerdown", (e: PointerEvent) => {
    e.preventDefault();
    try {
      stage.setPointerCapture(e.pointerId);
    } catch {}

    isDragging = true;
    startPointerX = e.clientX;
    lastPointerX = e.clientX;
    lastMoveTime = performance.now();
    dragVelocity = 0;
    stage.classList.add("is-dragging");
  });

  stage.addEventListener("pointermove", (e: PointerEvent) => {
    if (!isDragging) return;

    const now = performance.now();
    const dt = Math.max(1, now - lastMoveTime);
    const dx = e.clientX - lastPointerX;

    // Geser ke kanan (dx > 0) -> rotasi ke kanan
    // Sensitivitas: 1px drag = ~0.0042 radians
    const radDelta = dx * 0.0045;
    targetCarouselAngle += radDelta;
    currentCarouselAngle += radDelta; // Direct 1:1 feel during drag

    dragVelocity = radDelta / dt;
    lastPointerX = e.clientX;
    lastMoveTime = now;
  });

  const stopDrag = (e: PointerEvent) => {
    if (!isDragging) return;
    isDragging = false;
    try {
      stage.releasePointerCapture(e.pointerId);
    } catch {}
    stage.classList.remove("is-dragging");

    // Impart flick velocity & SNAP ke planet terdekat (kelipatan 120 deg)
    const flickMomentum = dragVelocity * 180;
    const projectedAngle = targetCarouselAngle + flickMomentum;
    targetCarouselAngle = Math.round(projectedAngle / STEP_RAD) * STEP_RAD;
  };

  stage.addEventListener("pointerup", stopDrag);
  stage.addEventListener("pointercancel", stopDrag);

  // ── TOMBOL PUTAR KIRI / KANAN & NAVIGASI ──
  // Putar Kiri: geser formasi 1 langkah ke kiri (+120 deg)
  if (prevBtn) {
    prevBtn.addEventListener("click", () => {
      targetCarouselAngle += STEP_RAD;
    });
  }

  // Putar Kanan: geser formasi 1 langkah ke kanan (-120 deg)
  if (nextBtn) {
    nextBtn.addEventListener("click", () => {
      targetCarouselAngle -= STEP_RAD;
    });
  }

  // Klik dot / planet untuk membawa planet tersebut ke posisi tengah depan
  function rotateToPlanet(targetIndex: number) {
    // Cari kelipatan STEP_RAD terdekat yang menempatkan targetIndex di depan tengah (phase % 2PI = 0)
    // planetPhase = targetCarouselAngle + targetIndex * STEP_RAD
    // Kita ingin planetPhase = kelipatan 2*PI, sehingga targetCarouselAngle = -targetIndex * STEP_RAD
    const targetOffset = -targetIndex * STEP_RAD;
    const currentRot = targetCarouselAngle;

    // Temukan kelipatan putaran (2*PI * k) terdekat agar animasi tidak berputar terlalu jauh
    const fullTurn = 2 * Math.PI;
    const diff = (targetOffset - currentRot) % fullTurn;
    let shortest = diff;
    if (diff > Math.PI) shortest -= fullTurn;
    if (diff < -Math.PI) shortest += fullTurn;

    targetCarouselAngle = currentRot + shortest;
  }

  planets.forEach((p) => {
    p.el.addEventListener("click", () => {
      rotateToPlanet(p.index);
    });
  });

  // ── 60FPS 3D RENDER LOOP ──
  let prevFrameTime = performance.now();

  function render(now: number) {
    const dt = Math.min(32, now - prevFrameTime);
    prevFrameTime = now;

    // ═══ PLANET INDUK AKTIF MENGORBIT OTOMATIS ═══
    if (!isDragging) {
      // Mengorbit otomatis secara halus dan terus-menerus
      targetCarouselAngle += 0.00042 * dt;
      currentCarouselAngle +=
        (targetCarouselAngle - currentCarouselAngle) * 0.085;
    }

    const { radiusX, radiusY } = getCarouselDimensions();
    const totalPlanets = planets.length;

    let closestPlanetIndex = 0;
    let maxZ = -Infinity;

    planets.forEach((p) => {
      // Phase tiap planet (0, 120deg, 240deg dari sudut carousel saat ini)
      const phase = currentCarouselAngle + p.index * STEP_RAD;

      // ═══ KOORDINAT SUSUNAN HORIZONTAL INLINE ═══
      // Sumbu X: sin(phase) memastikan saat phase=0 (planet tengah), X = 0!
      // Samping Kanan: phase = +120deg -> X = +0.866 * radiusX
      // Samping Kiri:  phase = -120deg -> X = -0.866 * radiusX
      // Jarak kiri dan kanan simetris proporsional!
      const x = radiusX * Math.sin(phase);

      // Kedalaman Z: cos(phase)
      // Tengah depan: cos(0) = +1 (terdepan, fokus utama)
      // Samping: cos(±120deg) = -0.5
      // Belakang: cos(180deg) = -1 (terjauh)
      const z = Math.cos(phase);

      // Sumbu Y: dijaga berjejer lurus secara horizontal di sumbu X!
      // Hanya ada kemiringan 3D sangat halus (-radiusY * z)
      const y = -radiusY * z;

      // Normalized Depth [0 = paling belakang, 1 = paling depan tengah]
      const normDepth = (z + 1) / 2;

      // Lacak planet terdepan untuk active indicator
      if (z > maxZ) {
        maxZ = z;
        closestPlanetIndex = p.index;
      }

      // ═══ 3D DYNAMIC PERSPECTIVE SCALING ═══
      // Tengah Depan (normDepth = 1.0): Scale 1.40 (membesar lebih dominan sebagai fokus utama)
      // Samping (normDepth = 0.25):     Scale 0.88 (proporsional mengapit di kiri dan kanan)
      // Belakang (normDepth = 0.0):     Scale 0.58 (mengecil saat melintas di belakang)
      const planetScale = 0.58 + Math.pow(normDepth, 1.15) * 0.82;

      // Z-INDEX: Depan = 34, Samping = 16, Belakang = 4
      const zIndex = Math.round(4 + normDepth * 30);

      // OPACITY: Depan = 1.0, Samping = 0.88, Belakang = 0.55
      const opacity = 0.55 + normDepth * 0.45;

      // Drop shadow dinamis untuk efek kedalaman
      const shadowBlur = Math.round(8 + normDepth * 28);
      const shadowAlpha = (0.06 + normDepth * 0.22).toFixed(2);

      p.el.style.transform = `translate3d(${x}px, ${y}px, 0) scale(${planetScale})`;
      p.el.style.zIndex = `${zIndex}`;
      p.el.style.opacity = `${opacity}`;
      p.el.style.filter = `drop-shadow(0 ${shadowBlur / 2}px ${shadowBlur}px rgba(0,0,0,${shadowAlpha}))`;

      // Catatan: Planet globe TIDAK dirotasi agar teks tetap tegak lurus dan terbaca jelas!
      p.globe.style.transform = "none";

      // ═══ SATELLITES INDUK MENGORBIT OTOMATIS SEARAH JARUM JAM (CLOCKWISE) ═══
      // Sudut bertambah secara kontinu searah jarum jam (clockwise)
      p.internalSpin += 0.00085 * dt;

      p.satellites.forEach((sat) => {
        // Satelit mengorbit searah jarum jam (clockwise: sudut positif bertambah dari 0 -> pi -> 2pi)
        const satAngle = sat.baseAngle + p.internalSpin;

        const cosA = Math.cos(satAngle);
        const sinA = Math.sin(satAngle);

        const x0 = sat.rx * cosA;
        const y0 = sat.ry * sinA;

        // Tilted orbit plane
        const sx = x0 * Math.cos(sat.tiltRad) - y0 * Math.sin(sat.tiltRad);
        const sy = x0 * Math.sin(sat.tiltRad) + y0 * Math.cos(sat.tiltRad);

        // Satelit depth scale relatif terhadap planetnya
        const satNormZ = (sinA + 1) / 2;
        const satScale = 0.74 + satNormZ * 0.52;
        const satZIndex = sinA >= 0 ? 20 : 2;

        sat.el.style.transform = `translate3d(${sx}px, ${sy}px, 0) scale(${satScale})`;
        sat.el.style.zIndex = `${satZIndex}`;
      });
    });

    requestAnimationFrame(render);
  }

  requestAnimationFrame(render);
</script>

<style>
  /* 3D Stage container */
  #carousel-stage {
    perspective: 1200px;
    will-change: transform;
  }

  #carousel-stage.is-dragging {
    cursor: grabbing !important;
  }

  /* Planet System Node */
  .planet-system-node {
    will-change: transform, opacity, filter;
    transition: filter 0.2s ease;
  }

  /* Central planet globe */
  .planet-globe {
    will-change: transform;
    transition: box-shadow 0.25s ease;
  }

  /* Satellites */
  .orbit-sat {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 36px;
    height: 36px;
    margin-top: -18px;
    margin-left: -18px;
    display: flex;
    align-items: center;
    justify-content: center;
    will-change: transform;
    cursor: pointer;
  }

  .sat-badge {
    width: 34px;
    height: 34px;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .orbit-sat:hover .sat-badge {
    transform: scale(1.22);
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.25);
  }
</style>
